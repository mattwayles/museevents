---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt?: string; title: string; href?: string }
const { image, alt = '', title, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class:list={['block bg-bg-soft px-4 pt-5 pb-8 text-center font-heading italic text-ink', href && 'hover:bg-[#f3e6dc] transition-colors']}>
  <Image src={image} alt={alt} width={186} height={186} widths={[186, 372]} sizes="186px" loading="lazy" class="mx-auto rounded-full w-[186px] h-[186px] object-cover" />
  <h2 class="text-2xl mt-6 mb-3">{title}</h2>
  <div class="text-[17px] leading-snug"><slot /></div>
</Tag>
