---
import { getSortedPosts, getArchive } from './BlogUtils';
const archive = getArchive(await getSortedPosts());
const { current } = Astro.props as { current?: string };
---
<aside>
  <h3 class="text-xl border-b border-accent pb-2 mb-4">Archive</h3>
  <ul class="text-sm space-y-1.5">
    {archive.map((a) => (
      <li>
        <a href={`/blog/archive/${a.key}`} class:list={['hover:text-primary', current === a.key && 'text-primary']}>{a.label} ({a.count})</a>
      </li>
    ))}
  </ul>
</aside>
