---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// Image + text side by side with an offset blush backdrop, as on the live site.
interface Props { image?: ImageMetadata; alt?: string; reverse?: boolean; eager?: boolean }
const { image, alt = '', reverse, eager } = Astro.props;
---
<section class="px-6 py-12 md:py-16 overflow-hidden">
  <div class:list={['mx-auto max-w-5xl grid gap-8 md:gap-16 items-center md:grid-cols-2', reverse && 'md:[&>*:first-child]:order-2']}>
    <div class="relative">
      <div class:list={['hidden md:block absolute bg-bg-soft w-[85%] h-[85%]', reverse ? '-right-8 -top-8' : '-left-8 -top-8']} aria-hidden="true"></div>
      <slot name="media">{image && <Image src={image} alt={alt} widths={[400, 600, 800]} sizes="(min-width: 768px) 440px, 100vw" loading={eager ? 'eager' : 'lazy'} class="relative w-full h-auto" />}</slot>
    </div>
    <div><slot /></div>
  </div>
</section>
