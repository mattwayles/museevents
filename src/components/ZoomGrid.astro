---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Item { src: ImageMetadata; alt?: string; caption?: string }
interface Props { items: Item[]; cols?: 2 | 3 }
const { items, cols = 3 } = Astro.props;
const id = 'zg' + Math.random().toString(36).slice(2, 8);
---
<div class="zoomgrid" data-zg={id}>
  <ul class:list={['grid gap-2.5 grid-cols-2', cols === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
    {items.map((it, i) => (
      <li>
        <button type="button" class="zg-open block w-full group" data-index={i} aria-label={`Enlarge: ${it.alt || it.caption || 'photo ' + (i + 1)}`}>
          <Image src={it.src} alt={it.alt ?? ''} width={600} height={420} widths={[300, 450, 600]} sizes="(min-width: 768px) 290px, 50vw" loading="lazy" class="w-full aspect-[10/7] object-cover transition-opacity group-hover:opacity-90" />
        </button>
        {it.caption && <p class="text-xs mt-1 text-center">{it.caption}</p>}
      </li>
    ))}
  </ul>
  <p class="text-center text-xs mt-2 text-muted">Press to zoom</p>
  <dialog class="zg-dialog m-auto max-w-[95vw] max-h-[95vh] bg-transparent p-0 backdrop:bg-black/80" aria-label="Photo viewer">
    <form method="dialog" class="relative">
      <button class="absolute top-2 right-2 bg-white/90 w-9 h-9 text-xl leading-none" aria-label="Close">×</button>
    </form>
    <img class="zg-big block max-w-[95vw] max-h-[90vh] object-contain" alt="" />
    <p class="zg-cap text-white text-center text-sm mt-2"></p>
    <button type="button" class="zg-prev absolute left-2 top-1/2 bg-white/90 w-9 h-9 text-xl" aria-label="Previous">‹</button>
    <button type="button" class="zg-next absolute right-2 top-1/2 bg-white/90 w-9 h-9 text-xl" aria-label="Next">›</button>
  </dialog>
  <script type="application/json" class="zg-data" set:html={JSON.stringify(items.map((it) => ({ src: it.src.src, alt: it.alt ?? '', caption: it.caption ?? '' })))}></script>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.zoomgrid').forEach((root) => {
    const data = JSON.parse(root.querySelector('.zg-data')!.textContent || '[]');
    const dlg = root.querySelector<HTMLDialogElement>('.zg-dialog')!;
    const big = root.querySelector<HTMLImageElement>('.zg-big')!;
    const cap = root.querySelector<HTMLElement>('.zg-cap')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + data.length) % data.length;
      big.src = data[cur].src; big.alt = data[cur].alt; cap.textContent = data[cur].caption || data[cur].alt;
    };
    root.querySelectorAll<HTMLButtonElement>('.zg-open').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.index)); dlg.showModal(); }));
    root.querySelector('.zg-prev')!.addEventListener('click', () => show(cur - 1));
    root.querySelector('.zg-next')!.addEventListener('click', () => show(cur + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
  });
</script>
