---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt?: string }
const { image, alt = '' } = Astro.props;
---
<div class="grid md:grid-cols-2 gap-4 items-stretch">
  <Image src={image} alt={alt} widths={[400, 600, 800]} sizes="(min-width: 768px) 440px, 100vw" loading="lazy" class="w-full h-full object-cover aspect-[4/3] md:aspect-auto" />
  <div class="bg-bg-soft px-6 py-6 font-heading italic text-[17px] leading-relaxed text-center md:text-left"><slot /></div>
</div>
