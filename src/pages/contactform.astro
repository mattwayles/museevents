---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { img } from '../lib/img';
---
<BaseLayout title="Contact | Muse Events | Colorado United States" description="Contact our staff, everyone from Event Planners, Wedding Planners, Party Planners Month of Wedding Coordinators and Day of Wedding Coordinators to discuss our event services and your unique celebration plans here in Colorado or Destination Weddings and Events">
  <div class="relative">
    <Image src={img('pages/contactform/image-040889.jpg')} alt="Bride and groom dancing in a wildflower meadow below snowy Colorado peaks" widths={[640, 1024, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="w-full h-[260px] md:h-[440px] object-cover object-[center_15%]" />
    <div class="absolute top-4 left-1/2 -translate-x-1/2 w-[160px] md:w-[220px] aspect-[1000/1125] overflow-hidden">
      <Image src={img('pages/home/image-5110c6.png')} alt="Muse Events, Colorado" widths={[320, 440]} sizes="(min-width: 768px) 440px, 320px" loading="eager" class="max-w-none h-auto w-[320px] md:w-[440px] -ml-[80px] md:-ml-[109px] -mt-[68px] md:-mt-[94px]" />
    </div>
  </div>

  <!-- The Aisle Planner form supplies its own "Muse Events" heading and intro, as on Wix -->
  <section class="relative px-4 md:-mt-[120px] pb-12">
    <div class="mx-auto max-w-5xl bg-bg px-4 md:px-12 pt-4 pb-10 text-center">
      <p class="font-heading italic text-xl mb-2">Book a Consultation</p>
      <ContactForm />
      <div class="font-heading italic mt-10 space-y-1">
        <p>Other Contact Info:</p>
        <p>Text Us : <a class="underline" href="sms:+17088260115">708.826.0115</a> (<a class="underline" href="tel:+17088260115">call</a>)</p>
        <p>Email: <a class="underline" href="mailto:Danielle@MuseEvents.com">Danielle@MuseEvents.com</a></p>
        <p><a class="underline" href="mailto:Info@museevents.com">Info@museevents.com</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
