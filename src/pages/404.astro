---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Muse Events" description="Sorry, we couldn't find that page.">
  <section class="px-6 py-24 text-center">
    <h1 class="font-heading text-4xl mb-4">We couldn't find that page</h1>
    <p class="mb-8">The page you're looking for may have moved. Try one of these instead:</p>
    <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3 font-heading italic text-lg">
      <li><a class="underline" href="/">Home</a></li>
      <li><a class="underline" href="/wedding-planning">Weddings</a></li>
      <li><a class="underline" href="/photo-albums">Gallery</a></li>
      <li><a class="underline" href="/contactform">Contact</a></li>
    </ul>
  </section>
</BaseLayout>
